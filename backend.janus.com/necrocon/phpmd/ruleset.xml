<?xml version="1.0"?>
<!--
    NECROCON — Janus PHPMD ruleset.
    Catches complexity, coupling, naming violations, and unused code.
-->
<ruleset name="Janus"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>Janus code quality rules for PHPMD.</description>

    <!-- ── Exclude test files and migrations ─────────────────────────── -->
    <exclude-pattern>*Test.php</exclude-pattern>
    <exclude-pattern>*BaseTest.php</exclude-pattern>
    <exclude-pattern>*/Infrastructure/Persistence/Migrations/*</exclude-pattern>
    <exclude-pattern>necrocon/</exclude-pattern>

    <!-- ══════════════════════════════════════════════════════════════════
         DESIGN RULES — complexity and size thresholds
         ══════════════════════════════════════════════════════════════════ -->
    <rule ref="rulesets/design.xml/CyclomaticComplexity">
        <properties>
            <property name="reportLevel" value="10"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml/NPathComplexity">
        <properties>
            <property name="minimum" value="200"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="30"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml/ExcessiveClassLength">
        <properties>
            <property name="minimum" value="300"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="6"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml/ExcessivePublicCount">
        <properties>
            <property name="minimum" value="20"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml/TooManyFields">
        <properties>
            <property name="maxfields" value="15"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml/TooManyMethods">
        <properties>
            <property name="maxmethods" value="20"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml/TooManyPublicMethods">
        <properties>
            <property name="maxmethods" value="15"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml/ExcessiveClassComplexity">
        <properties>
            <property name="maximum" value="50"/>
        </properties>
    </rule>

    <!-- ══════════════════════════════════════════════════════════════════
         NAMING RULES
         ══════════════════════════════════════════════════════════════════ -->
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="minimum" value="2"/>
            <property name="exceptions" value="id,i,e,x,y"/>
        </properties>
    </rule>

    <rule ref="rulesets/naming.xml/LongVariable">
        <properties>
            <property name="maximum" value="40"/>
        </properties>
    </rule>

    <rule ref="rulesets/naming.xml/ShortMethodName">
        <properties>
            <property name="minimum" value="3"/>
            <property name="exceptions" value="up,id,of"/>
        </properties>
    </rule>

    <rule ref="rulesets/naming.xml/ConstructorWithNameAsEnclosingClass"/>
    <rule ref="rulesets/naming.xml/ConstantNamingConventions"/>
    <rule ref="rulesets/naming.xml/BooleanGetMethodName"/>

    <!-- ══════════════════════════════════════════════════════════════════
         UNUSED CODE
         ══════════════════════════════════════════════════════════════════ -->
    <rule ref="rulesets/unusedcode.xml/UnusedPrivateField"/>
    <rule ref="rulesets/unusedcode.xml/UnusedLocalVariable"/>
    <rule ref="rulesets/unusedcode.xml/UnusedPrivateMethod"/>
    <rule ref="rulesets/unusedcode.xml/UnusedFormalParameter"/>

    <!-- ══════════════════════════════════════════════════════════════════
         CLEAN CODE
         ══════════════════════════════════════════════════════════════════ -->
    <rule ref="rulesets/cleancode.xml/BooleanArgumentFlag"/>
    <rule ref="rulesets/cleancode.xml/ElseExpression"/>
    <rule ref="rulesets/cleancode.xml/StaticAccess">
        <!-- Allow static access on self/static — needed for enums and value objects -->
        <properties>
            <property name="exceptions" value="self,static"/>
        </properties>
    </rule>

    <!-- ══════════════════════════════════════════════════════════════════
         CONTROVERSIAL
         ══════════════════════════════════════════════════════════════════ -->
    <rule ref="rulesets/controversial.xml/CamelCaseClassName"/>
    <rule ref="rulesets/controversial.xml/CamelCasePropertyName"/>
    <rule ref="rulesets/controversial.xml/CamelCaseMethodName"/>
    <rule ref="rulesets/controversial.xml/CamelCaseParameterName"/>
    <rule ref="rulesets/controversial.xml/CamelCaseVariableName"/>

</ruleset>
