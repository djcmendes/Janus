<?xml version="1.0" encoding="UTF-8"?>
<!--
    Janus root PHP_CodeSniffer config.
    Delegates all rules to the NECROCON standard.
-->
<ruleset name="Janus Project">

    <description>Janus project PHPCS config — imports the NECROCON standard.</description>

    <!-- Import all rules from the NECROCON standard -->
    <rule ref="necrocon/phpcs/ruleset.xml"/>

    <!-- Files / directories to check -->
    <file>src/</file>

    <!-- Globally excluded paths -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>
    <exclude-pattern>*/Infrastructure/Persistence/Migrations/*</exclude-pattern>
    <exclude-pattern>necrocon/</exclude-pattern>

    <!-- Output settings -->
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="extensions" value="php"/>

</ruleset>
